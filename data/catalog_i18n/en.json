  "ssb": {
   "name": "Solar System Barycenter"
  },
  "naif:10": {
   "name": "Sun",
   "wiki": "Sun",
   "magnetic": {
    "src": "source-surface dipole model at 2.5 radii (Altschuler and Newkirk, 1969; Schatten, Wilcox and Ness, 1969). It is a sketch of the Sun near activity minimum: the real field changes continuously and cannot be predicted in the long term"
   }
  },
  "naif:199": {
   "name": "Mercury",
   "wiki": "Mercury (planet)",
   "magnetic": {
    "src": "MESSENGER (Anderson and collaborators, 2012): tilt below 0.8°, center offset 479 km to the north; magnetopause at about 1.4 radii"
   }
  },
  "naif:299": {
   "name": "Venus",
   "wiki": "Venus"
  },
  "naif:399": {
   "name": "Earth",
   "wiki": "Earth",
   "magnetic": {
    "src": "WMM2025 and IGRF-14 (NOAA, IAGA): north geomagnetic pole at 80.8° N, 72.8° W, axis tilted by 9.2°; magnetopause at 6–15 radii, usually 10"
   }
  },
  "naif:499": {
   "name": "Mars",
   "wiki": "Mars"
  },
  "naif:599": {
   "name": "Jupiter",
   "wiki": "Jupiter",
   "rings": {
    "src": "Voyager, Galileo and New Horizons: inner halo, main ring (from 122,500 to 129,000 km) and two «gossamer» rings made of dust knocked off the moons Amalthea and Thebe. They are so faint that they cannot be seen from Earth: in the drawing they are much more visible than in reality"
   },
   "magnetic": {
    "src": "JRM09 (Connerney and collaborators, 2018, Juno probe): axis tilted by 10.3° towards west longitude 196.6°; magnetopause at 45–100 radii"
   },
   "phys": {
    "moons_note": "more than 90 known moons; the number grows with new discoveries"
   }
  },
  "naif:699": {
   "name": "Saturn",
   "wiki": "Saturn",
   "magnetic": {
    "src": "Cassini Grand Finale (Cao and collaborators): tilt below 0.007°, magnetic equator offset by 0.047 radii (2820 km) to the north; magnetopause at 16–22 radii"
   },
   "phys": {
    "moons_note": "274 recognized moons (March 2025): the planet with the most known moons"
   }
  },
  "naif:799": {
   "name": "Uranus",
   "wiki": "Uranus",
   "rings": {
    "src": "Discovered in 1977 by watching a star disappear behind them, then photographed by Voyager 2 (1986): nine very narrow main rings, dark as coal (6, 5, 4, α, β, η, γ, δ, ε), plus the faint λ. The widest, ε, measures from 20 to 96 km. In the drawing they are brighter and a little wider than in reality, otherwise they could not be seen"
   },
   "magnetic": {
    "src": "Voyager 2 (Ness and collaborators, 1986): dipole tilted by 59° and offset by 0.31 radii towards the south pole; magnetopause at 18 radii"
   },
   "phys": {
    "moons_note": "29 known moons after the discovery of S/2025 U1 with the James Webb Space Telescope (2025)"
   }
  },
  "naif:899": {
   "name": "Neptune",
   "wiki": "Neptune",
   "rings": {
    "src": "Voyager 2 (1989): five dust rings, from the inside Galle, Le Verrier, Lassell, Arago and Adams. In the Adams ring the material is gathered in a few denser arcs (not drawn here). In the drawing they are more visible than in reality"
   },
   "magnetic": {
    "src": "Voyager 2 (Ness and collaborators, 1989): dipole tilted by 47° and offset by 0.55 radii; magnetopause at 26.5 radii"
   }
  },
